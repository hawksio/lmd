# Copy to /etc/lmd/lmd.env on the server (chmod 600, owner root). NEVER commit the real file.
# Every variable is documented in backend/config.py and the README.

LMD_ENV=production
LMD_SECRET_KEY=                       # generate: python3 -c "import secrets; print(secrets.token_hex(32))"
LMD_SECURE_COOKIES=1
LMD_BASE_URL=https://lmdglobalfinltd.com
LMD_INSTANCE_DIR=/srv/lmd/instance
LMD_TRUST_PROXY=1                     # nginx in front
LMD_SESSION_IDLE_MINUTES=30
LMD_SESSION_HOURS=8
LMD_REQUIRE_STAFF_MFA=1
LMD_MAX_UPLOAD_MB=10

# Transactional email (account, application and security messages)
LMD_SMTP_HOST=smtp.hostinger.com      # or your provider
LMD_SMTP_PORT=465
LMD_SMTP_USER=no-reply@lmdglobalfinltd.com
LMD_SMTP_PASSWORD=
LMD_MAIL_FROM=LMD Finance <no-reply@lmdglobalfinltd.com>
LMD_MAIL_REPLY_TO=                    # a monitored inbox, once it exists
LMD_STAFF_EMAILS=                     # optional; default = all administrators and reviewers
LMD_MAIL_ALLOWED_DOMAINS=             # staging only: e.g. lmdglobalfinltd.com

# Marketing email: leave disabled until the marketing checklist is complete
LMD_MARKETING_ENABLED=0
LMD_MARKETING_SMTP_HOST=
LMD_MARKETING_SMTP_PORT=587
LMD_MARKETING_SMTP_USER=
LMD_MARKETING_SMTP_PASSWORD=
LMD_MARKETING_FROM=LMD Finance <news@lmdglobalfinltd.com>
LMD_MARKETING_RATE_PER_MINUTE=60

# Optional AI help assistant (Anthropic). Empty = off.
LMD_AI_API_KEY=
LMD_AI_MODEL=claude-opus-5-5
LMD_AI_STAFF_FEATURES=0               # 1 only after a data-processing agreement is in place

# Multi-organisation hosting
LMD_PLATFORM_HOST=console.lmdglobalfinltd.com   # platform-owner console (example host: choose your own)
LMD_TENANT_BASE_DOMAIN=lmdglobalfinltd.com      # organisations get <slug>.lmdglobalfinltd.com
LMD_DEFAULT_ORG=                                 # MUST be empty in production: unknown hosts get 404
LMD_STATIC_SITE_ORG=lmd                          # organisation that owns the static site in public/
# Agreement-template approval is now a per-organisation setting (Organisation settings), not a variable.
