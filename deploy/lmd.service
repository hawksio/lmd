# /etc/systemd/system/lmd.service
[Unit]
Description=LMD Finance web app (gunicorn)
After=network.target

[Service]
User=lmd
Group=lmd
WorkingDirectory=/srv/lmd/app
EnvironmentFile=/etc/lmd/lmd.env
ExecStart=/srv/lmd/app/.venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lmd/instance /srv/lmd/app/public
UMask=0077

[Install]
WantedBy=multi-user.target
